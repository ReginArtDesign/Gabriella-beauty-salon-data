interface PremiumTreatmentCardProps {

    stepNumber?: string

    savingLabel?: string

    teaserText?: string

    highlightIcon?: string

    title?: string

    description?: React.ReactNode

    price?: string

    priceAbo1?: string

    priceAbo2?: string

    priceAbo3?: string

    duration?: string

    image?: string

    calHref?: string

    bgColor?: string

    accentColor?: string

    textColor?: string

    mutedColor?: string

}



export default function PremiumTreatmentCard({

    stepNumber = "01",

    savingLabel = "",

    teaserText = "",

    highlightIcon = "gift",

    title = "Microdermabrasion",

    description = "Zuallererst werden abgestorbene Hautzellen mit Hilfe der Mikrodermabrasion entfernt, bis die gesunde Haut zum Vorschein kommt.",

    price = "165 CHF",

    priceAbo1 = "3er Abo 450 CHF",

    priceAbo2 = "5er Abo 700 CHF",

    priceAbo3 = "10er Abo 1300 CHF",

    duration = "90 Min",

    image = "https://framerusercontent.com/images/oYVb9w6e6MrqNh41nR5E1E7Ck0.png",

    calHref = "https://cal.eu/gabriellasbeauty/klassische-gesichtsbehandlung",

    bgColor = "#F7ECDF",

    accentColor = "#A6807C",

    textColor = "#3A3028",

    mutedColor = "#7A7369",

}: PremiumTreatmentCardProps) {

    const [isOpen, setIsOpen] = useState(false)

    const [isSuccess, setIsSuccess] = useState(false)

    const isMobile = useMemo(

        () => (typeof window !== "undefined" ? window.innerWidth < 768 : true),

        []

    )



    useEffect(() => {

        if (!isOpen) {

            setIsSuccess(false)

            return

        }

        const handleMessage = (e: MessageEvent) => {

            const data = e.data

            if (!data) return

            const type = data?.type || data?.event || ""

            if (

                type === "booking-successful" ||

                type === "bookingSuccessful" ||

                type === "cal:booking-successful" ||

                type === "__cal__booking_successful"

            ) {

                setIsSuccess(true)

            }

        }

        window.addEventListener("message", handleMessage)

        return () => window.removeEventListener("message", handleMessage)

    }, [isOpen])



    const iframeSrc = calHref

        ? `${calHref}?embed=true&theme=light&layout=month_view&hideEventTypeDetails=1`

        : ""



    const hasHighlight = savingLabel.trim() !== "" || teaserText.trim() !== ""



    return (

        <>

            <style>{`

                .ptc-box {

                    width: 100%; height: 100%; display: flex; flex-direction: column; gap: 16px; background: transparent;

                    font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; box-sizing: border-box;

                    padding-bottom: 24px; border-bottom: 1px solid ${accentColor}15; position: relative;

                }

                

                /* KÉPMÉRET JAVÍTÁSA: max-height és 16/9 arány */

                .ptc-media { 

                    width: 100%; aspect-ratio: 16 / 9; max-height: 240px; position: relative; 

                    overflow: hidden; border-radius: 4px; background: ${accentColor}08; flex-shrink: 0;

                }

                .ptc-img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }

                .ptc-box:hover .ptc-img { transform: scale(1.04); }

                

                /* FŐ KONTÉNER: A kártya rugalmasan nő */

                .ptc-details { 

                    padding: 4px 0 0 0; display: flex; flex-direction: column; flex: 1; gap: 20px; 

                }

                

                /* SOHASEM VÁLIK SZÉT A CÍM ÉS A LEÍRÁS */

                .ptc-content-group {

                    display: flex; flex-direction: column; justify-content: flex-start; gap: 12px;

                }



                /* A GOMB ÉS A CÍMKÉK MINDIG AZ ALJÁN MARADNAK */

                .ptc-action-group {

                    display: flex; flex-direction: column; gap: 12px; margin-top: auto; align-items: flex-start;

                }

                

                /* ── KIEMELT DOBÓZ ── */

                .ptc-highlight-box {

                    display: flex; align-items: flex-start; gap: 12px; padding: 14px 18px;

                    background: #FFFFFF; border-radius: 4px; border-left: 3px solid ${accentColor};

                    box-shadow: 0 4px 14px rgba(0,0,0,0.04); margin-bottom: 4px;

                }

                .ptc-highlight-icon { width: 20px; height: 20px; color: ${accentColor}; flex-shrink: 0; margin-top: 2px; }

                .ptc-highlight-text { display: flex; flex-direction: column; gap: 2px; }

                .ptc-saving-label { font-family: 'Montserrat', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: ${accentColor}; line-height: 1.3; }

                .ptc-teaser-text { font-size: 13.5px; font-weight: 500; color: ${textColor}; line-height: 1.4; }



                /* META & ÁR */

                .ptc-meta-line { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: -4px; }

                .ptc-tag { font-family: 'Montserrat', sans-serif; font-size: 11px; font-weight: 600; text-transform: uppercase; color: ${mutedColor}; padding: 4px 0; display: flex; align-items: center; gap: 6px; }

                .ptc-tag--price { color: #FFFFFF; background: ${accentColor}; padding: 5px 12px; border-radius: 2px; letter-spacing: 0.04em; }

                

                /* CÍM ÉS LEÍRÁS */

                .ptc-title { font-family: 'Montserrat', sans-serif; font-size: 20px; font-weight: 500; color: ${textColor}; margin: 0; letter-spacing: -0.01em; transition: color 0.3s; }

                .ptc-box:hover .ptc-title { color: ${accentColor}; }

                .ptc-desc-wrap { font-size: 14px; line-height: 1.65; color: ${mutedColor}; max-width: 95%; margin: 0; }

                .ptc-desc-wrap > *:first-child { margin-top: 0; }

                .ptc-desc-wrap > *:last-child { margin-bottom: 0; }

                .ptc-desc-wrap p { margin: 0 0 12px 0; }

                .ptc-desc-wrap strong { color: ${textColor}; font-weight: 600; }

                

                /* ── BÉRLET (ABO) CÍMKÉK ── */

                .ptc-abo-wrapper { display: flex; flex-direction: row; gap: 10px; width: 100%; flex-wrap: wrap; }

                .ptc-abo-tag {

                    display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px;

                    border-radius: 2px; border: 1px solid ${accentColor}40; background: transparent; color: ${mutedColor};

                    font-family: 'Montserrat', sans-serif; font-size: 11px; font-weight: 500; letter-spacing: 0.02em;

                    transition: all 0.3s ease;

                }

                .ptc-abo-tag--solid { background: ${accentColor}; border-color: ${accentColor}; color: #FFFFFF; font-weight: 600; }



                /* CTA GOMB (Design System frissítés) */

                .cp-btn {

                    display: inline-flex; align-items: center; justify-content: center; padding: 14px 28px; color: #FFFFFF;

                    font-family: 'Montserrat', sans-serif; font-size: 11px; font-weight: 600; letter-spacing: 0.12em;

                    text-transform: uppercase; border: none; 

                    border-radius: 4px; /* Brand Guidelines */

                    cursor: pointer; width: max-content;

                    box-shadow: 0 4px 16px rgba(0,0,0,0.12); /* Brand Guidelines */

                    transition: background 0.3s, transform 0.2s;

                }

                .cp-btn:hover { filter: brightness(1.05); transform: translateY(-1px); }



                /* MOBIL NÉZET */

                @media (max-width: 768px) { 

                    .ptc-media { max-height: 220px; }

                    .cp-btn { width: 100%; }

                    .ptc-action-group { width: 100%; align-items: stretch; }

                    .ptc-abo-wrapper { flex-direction: column; align-items: flex-start; gap: 10px; }

                    .ptc-abo-tag { width: auto; }

                }

            `}</style>



            <article className="ptc-box">

                <div className="ptc-media">

                    <img

                        src={image}

                        alt={title}

                        className="ptc-img"

                        loading="lazy"

                    />

                    <div

                        style={{

                            position: "absolute",

                            inset: 0,

                            background: textColor,

                            opacity: 0,

                            mixBlendMode: "overlay",

                            transition: "opacity 0.4s",

                        }}

                    />

                </div>

                <div className="ptc-details">

                    {hasHighlight && (

                        <div className="ptc-highlight-box">

                            <div className="ptc-highlight-icon">

                                {HIGHLIGHT_ICONS[highlightIcon] ||

                                    HIGHLIGHT_ICONS["gift"]}

                            </div>

                            <div className="ptc-highlight-text">

                                {savingLabel && (

                                    <span className="ptc-saving-label">

                                        {savingLabel}

                                    </span>

                                )}

                                {teaserText && (

                                    <span className="ptc-teaser-text">

                                        {teaserText}

                                    </span>

                                )}

                            </div>

                        </div>

                    )}



                    {/* VÉDŐKONTÉNER: Ez a blokk sosem esik szét Flexbox nyúlásnál */}

                    <div className="ptc-content-group">

                        <div className="ptc-meta-line">

                            {duration && duration !== "Variabel" && (

                                <span className="ptc-tag">

                                    <IconClock /> {duration}

                                </span>

                            )}

                            {price && (

                                <span className="ptc-tag ptc-tag--price">

                                    {price}

                                </span>

                            )}

                        </div>



                        <h3 className="ptc-title">{title}</h3>

                        <div className="ptc-desc-wrap">{description}</div>

                    </div>



                    {/* GOMB & BÉRLETEK: Automatikusan letolva a kártya legaljára */}

                    <div className="ptc-action-group">

                        {(priceAbo1 || priceAbo2 || priceAbo3) && (

                            <div className="ptc-abo-wrapper">

                                {priceAbo1 && (

                                    <div className="ptc-abo-tag">

                                        <IconSmallCheck />

                                        <span>{priceAbo1}</span>

                                    </div>

                                )}

                                {priceAbo2 && (

                                    <div className="ptc-abo-tag">

                                        <IconSmallCheck />

                                        <span>{priceAbo2}</span>

                                    </div>

                                )}

                                {priceAbo3 && (

                                    <div className="ptc-abo-tag ptc-abo-tag--solid">

                                        <IconSmallStar />

                                        <span>{priceAbo3}</span>

                                    </div>

                                )}

                            </div>

                        )}



                        <motion.button

                            type="button"

                            onClick={() => setIsOpen(true)}

                            whileTap={{ scale: 0.98 }}

                            className="cp-btn"

                            style={{ background: accentColor }}

                        >

                            Jetzt Buchen

                        </motion.button>

                    </div>

                </div>

            </article>



            {/* NAPTÁR ÉS NATIVE SUCCESS MODAL INTEGRÁCIÓ */}

            <AnimatePresence>

                {isOpen && (

                    <>

                        <motion.div

                            initial={{ opacity: 0 }}

                            animate={{ opacity: 1 }}

                            exit={{ opacity: 0 }}

                            onClick={() => setIsOpen(false)}

                            style={{

                                position: "fixed",

                                inset: 0,

                                background: "rgba(58,48,40,0.35)",

                                zIndex: 9998,

                                backdropFilter: "blur(6px)",

                                WebkitBackdropFilter: "blur(6px)",

                            }}

                        />

                        <motion.div

                            initial={

                                isMobile

                                    ? { y: "100%" }

                                    : { opacity: 0, scale: 0.98, y: 15 }

                            }

                            animate={

                                isMobile

                                    ? { y: 0 }

                                    : { opacity: 1, scale: 1, y: 0 }

                            }

                            exit={

                                isMobile

                                    ? { y: "100%" }

                                    : { opacity: 0, scale: 0.98, y: 15 }

                            }

                            transition={{

                                type: "spring",

                                damping: 32,

                                stiffness: 220,

                            }}

                            style={

                                isMobile

                                    ? {

                                          position: "fixed",

                                          left: 0,

                                          right: 0,

                                          bottom: 0,

                                          height: "88dvh",

                                          background: bgColor,

                                          borderRadius: "24px 24px 0 0",

                                          zIndex: 9999,

                                          display: "flex",

                                          flexDirection: "column",

                                          overflow: "hidden",

                                      }

                                    : {

                                          position: "fixed",

                                          inset: 0,

                                          margin: "auto",

                                          width: "85vw",

                                          maxWidth: 840,

                                          height: "82vh",

                                          maxHeight: 700,

                                          background: bgColor,

                                          borderRadius: 4,

                                          zIndex: 9999,

                                          display: "flex",

                                          flexDirection: "column",

                                          overflow: "hidden",

                                          border: `1px solid ${accentColor}15`,

                                      }

                            }

                        >

                            <div

                                style={{

                                    flexShrink: 0,

                                    padding: "24px",

                                    borderBottom: `1px solid ${accentColor}12`,

                                }}

                            >

                                <div

                                    style={{

                                        fontFamily: "'Montserrat', sans-serif",

                                        fontSize: 18,

                                        color: textColor,

                                    }}

                                >

                                    {title}

                                </div>

                            </div>

                            <div

                                style={{

                                    flex: 1,

                                    background: isSuccess ? bgColor : "#FFF",

                                }}

                            >

                                {isSuccess ? (

                                    <div

                                        style={{

                                            display: "flex",

                                            flexDirection: "column",

                                            alignItems: "center",

                                            justifyContent: "center",

                                            height: "100%",

                                            padding: "24px",

                                            textAlign: "center",

                                        }}

                                    >

                                        <div

                                            style={{

                                                width: 56,

                                                height: 56,

                                                borderRadius: "50%",

                                                background: "#FFF",

                                                border: `1px solid ${accentColor}30`,

                                                display: "flex",

                                                alignItems: "center",

                                                justifyContent: "center",

                                                marginBottom: 20,

                                            }}

                                        >

                                            <svg

                                                width="22"

                                                height="22"

                                                viewBox="0 0 24 24"

                                                fill="none"

                                                stroke={accentColor}

                                                strokeWidth="1.5"

                                            >

                                                <polyline points="20 6 9 17 4 12" />

                                            </svg>

                                        </div>

                                        <h3

                                            style={{

                                                fontFamily:

                                                    "'Montserrat', sans-serif",

                                                fontSize: 24,

                                                fontWeight: 300,

                                                color: textColor,

                                            }}

                                        >

                                            Vielen Dank!

                                        </h3>

                                        <p

                                            style={{

                                                fontSize: 14,

                                                color: mutedColor,

                                                maxWidth: 400,

                                                marginBottom: 24,

                                            }}

                                        >

                                            Ihre Reservierung für die Behandlung{" "}

                                            <strong>{title}</strong> war

                                            erfolgreich.

                                        </p>

                                        <button

                                            onClick={() => setIsOpen(false)}

                                            className="cp-btn"

                                            style={{

                                                background: accentColor,

                                                padding: "12px 36px",

                                            }}

                                        >

                                            Schliessen

                                        </button>

                                    </div>

                                ) : iframeSrc ? (

                                    <iframe

                                        src={iframeSrc}

                                        style={{

                                            width: "100%",

                                            height: "100%",

                                            border: "none",

                                            display: "block",

                                        }}

                                        allow="payment"

                                    />

                                ) : (

                                    <div

                                        style={{

                                            display: "flex",

                                            alignItems: "center",

                                            justifyContent: "center",

                                            height: "100%",

                                            color: mutedColor,

                                            fontFamily: "'Inter', sans-serif",

                                            fontSize: 14,

                                        }}

                                    >

                                        Buchungslink nicht verfügbar.

                                    </div>

                                )}

                            </div>

                        </motion.div>

                    </>

                )}

            </AnimatePresence>

        </>

    )

}



