                    <div className="cp-container">

                        <div className="cp-list-header">

                            <h2 className="cp-list-title">Behandlungen</h2>

                            <div className="cp-list-badge">

                                {totalTreatments} Angebote

                            </div>

                        </div>



                        {visibleCategories.map((category) => (

                            <div

                                key={category.id}

                                className="cp-category-group"

                            >

                                {categoryFilter === "alle" && (

                                    <div className="cp-category-header">

                                        <h3 className="cp-category-title">

                                            {category.title}

                                        </h3>

                                        <p className="cp-category-lead">

                                            {category.leadText}

                                        </p>

                                    </div>

                                )}

                                <div className="cp-rows">

                                    {category.items.map(

                                        (treatment, itemIdx) => (

                                            <TreatmentRow

                                                key={`${category.id}-${itemIdx}`}

                                                treatment={treatment}

                                                index={itemIdx}

                                                onBook={(t: any) =>

                                                    setSelectedTreatment(t)

                                                }

                                                accentColor={accentColor}

                                                bgColor={heroBgColor}

                                                textColor={textColor}

                                                mutedColor={mutedColor}

                                                borderColor={borderColor}

                                            />

                                        )

                                    )}

                                </div>

                            </div>

                        ))}



                        <div className="cp-bottom-divider">

                            <div className="cp-divider-line"></div>

                            <div className="cp-divider-diamond"></div>

                            <div className="cp-divider-line"></div>

                        </div>

                    </div>

                </section>



                <BookingModal

                    treatment={selectedTreatment}

                    onClose={() => setSelectedTreatment(null)}

                    accentColor={accentColor}

                    bgColor="#ffffff"

                    textColor={textColor}

                    mutedColor={mutedColor}

                />

            </div>

        </>

    )

