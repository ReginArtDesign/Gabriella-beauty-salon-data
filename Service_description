function BookingModal({

    treatment,

    onClose,

    accentColor,

    bgColor,

    textColor,

    mutedColor,

}: any) {

    const [isSuccess, setIsSuccess] = useState(false)

    const isMobile = useMemo(

        () => (typeof window !== "undefined" ? window.innerWidth < 768 : true),

        []

    )



    useEffect(() => {

        if (!treatment) {

            setIsSuccess(false)

            return

        }

        const handleMessage = (e: MessageEvent) => {

            const data = e.data

            if (!data) return

            const type = data?.type || data?.event || ""

            if (

                type === "booking-successful" ||

                type === "bookingSuccessful" ||

                type === "cal:booking-successful" ||

                type === "__cal__booking_successful"

            ) {

                setIsSuccess(true)

            }

        }

        window.addEventListener("message", handleMessage)

        return () => window.removeEventListener("message", handleMessage)

    }, [treatment])



    const iframeSrc = treatment?.calHref

        ? `${treatment.calHref}?embed=true&theme=light&layout=month_view&hideEventTypeDetails=1`

        : ""



    return (

        <AnimatePresence>

            {treatment && (

                <>

                    <motion.div

                        initial={{ opacity: 0 }}

                        animate={{ opacity: 1 }}

                        exit={{ opacity: 0 }}

                        onClick={onClose}

                        className="cp-modal-overlay"

                    />

                    <motion.div

                        initial={

                            isMobile

                                ? { y: "100%" }

                                : { opacity: 0, scale: 0.98, y: 15 }

                        }

                        animate={

                            isMobile ? { y: 0 } : { opacity: 1, scale: 1, y: 0 }

                        }

                        exit={

                            isMobile

                                ? { y: "100%" }

                                : { opacity: 0, scale: 0.98, y: 15 }

                        }

                        transition={{

                            type: "spring",

                            damping: 32,

                            stiffness: 220,

                        }}

                        className="cp-modal-content"

                        style={

                            isMobile

                                ? { background: bgColor }

                                : {

                                      background: bgColor,

                                      border: `1px solid ${accentColor}20`,

                                  }

                        }

                    >

                        <div className="cp-modal-header">

                            <div className="cp-modal-drag-handle">

                                <div

                                    style={{

                                        width: 40,

                                        height: 4,

                                        borderRadius: 2,

                                        background: mutedColor,

                                        opacity: 0.3,

                                    }}

                                />

                            </div>

                            <button

                                type="button"

                                onClick={onClose}

                                className="cp-modal-close-btn"

                                style={{ color: textColor }}

                            >

                                <IconClose />

                            </button>

                            <div className="cp-modal-header-info">

                                <h3

                                    style={{

                                        fontFamily: "'Montserrat', sans-serif",

                                        fontSize: 20,

                                        color: textColor,

                                        margin: 0,

                                    }}

                                >

                                    {treatment.name}

                                </h3>

                            </div>

                        </div>

                        <div className="cp-modal-iframe-wrap">

                            {isSuccess ? (

                                <div

                                    style={{

                                        display: "flex",

                                        flexDirection: "column",

                                        alignItems: "center",

                                        justifyContent: "center",

                                        height: "100%",

                                        padding: 32,

                                        textAlign: "center",

                                    }}

                                >

                                    <h3

                                        style={{

                                            fontFamily:

                                                "'Montserrat', sans-serif",

                                            fontSize: 24,

                                            color: textColor,

                                        }}

                                    >

                                        Vielen Dank!

                                    </h3>

                                    <p

                                        style={{

                                            color: mutedColor,

                                            marginBottom: 24,

                                        }}

                                    >

                                        Ihre Reservierung war erfolgreich.

                                    </p>

                                    <button

                                        onClick={onClose}

                                        className="cp-btn"

                                        style={{ background: accentColor }}

                                    >

                                        Schliessen

                                    </button>

                                </div>

                            ) : iframeSrc ? (

                                <iframe

                                    src={iframeSrc}

                                    style={{

                                        width: "100%",

                                        height: "100%",

                                        border: "none",

                                    }}

                                    allow="payment"

                                />

                            ) : (

                                <div

                                    style={{

                                        display: "flex",

                                        alignItems: "center",

                                        justifyContent: "center",

                                        height: "100%",

                                        color: mutedColor,

                                    }}

                                >

                                    Buchungslink nicht verfügbar.

                                </div>

                            )}

                        </div>

                    </motion.div>

                </>

            )}

        </AnimatePresence>

    )

