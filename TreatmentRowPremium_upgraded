            ) : (
                // ── DESKTOP / TABLET NÉZET: vízszintes sor, nagyobb thumbnail + szöveges gombok ──
                <motion.div
                    ref={rowRef}
                    className={
                        isOpen && imageExpands ? "trp-row is-open" : "trp-row"
