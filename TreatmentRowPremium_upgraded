            priceRange?: string
            goal?: string
        }) => {
            const cat = state.category || "alle"
            const catOk =
                !cat ||
                cat === "alle" ||
                (category || "").toLowerCase() === cat.toLowerCase()

            const q = (state.search || "").trim().toLowerCase()
            const goalsList = (goalsCsv || "")
                .split(",")
                .map((g) => g.trim().toLowerCase())
                .filter(Boolean)
            const searchKeywordsMatch = (searchKeywordsCsv || "")
                .toLowerCase()
                .includes(q)
            const searchOk =
                q === "" ||
                (name || "").toLowerCase().includes(q) ||
                (description || "").toLowerCase().includes(q) ||
                goalsList.some((g) => g.includes(q) || q.includes(g)) ||
                searchKeywordsMatch

            const priceRange = state.priceRange || "alle"
            let priceOk = true
            if (priceRange !== "alle") {
                const [minS, maxS] = priceRange.split("-")
                const min = parseInt(minS, 10) || 0
                const max = parseInt(maxS, 10) || 999999
                const price = parsePriceNumber(priceSingle)
                priceOk = price >= min && price <= max
            }

            const goal = state.goal || "alle"
            let goalOk = true
            if (goal !== "alle") {
                const goals = (goalsCsv || "")
                    .split(",")
                    .map((g) => g.trim().toLowerCase())
                    .filter(Boolean)
                goalOk = goals.includes(goal.toLowerCase())
            }

            setVisible(catOk && searchOk && priceOk && goalOk)
        }

        const win = window as any
        if (win.__iplFilterState) evaluate(win.__iplFilterState)

        const handler = (e: Event) => {
            evaluate((e as CustomEvent).detail || {})
        }
        window.addEventListener("ipl-filter", handler)
        return () => window.removeEventListener("ipl-filter", handler)
    }, [category, name, description, priceSingle, goalsCsv, searchKeywordsCsv])

    return visible
}

