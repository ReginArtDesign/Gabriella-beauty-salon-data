// ─────────────────────────────────────────────────────────────────────────────
// TRAFFT ELŐMELEGÍTÉS (warm-up)
//
// A Trafft foglalóoldal 211 kérésből és ~1,7 MB-ból áll, a szerverük válaszideje
// ~690 ms, a teljes betöltés ~6,3 s. Ezen a kódunk nem tud gyorsítani — viszont
// a 178 statikus fájljuk `public, max-age=14400` fejléccel jön, tehát 4 órára
// gyorsítótárazható.
//
// Ezért amikor a látogató RÁHÚZZA az egeret egy foglalás gombra (mobilon:
// megérinti), 200 ms késleltetés után elindítunk EGY rejtett iframe-et. Mire
// tényleg rákattint, a statikus fájlok már a cache-ben vannak.
//
// FONTOS: ez modul szintű, tehát oldalanként EGYETLEN egyszer fut le, akkor is,
// ha 16 kezelés-sor van az oldalon — mind ugyanazokat a Trafft fájlokat tölti,
// így egy előmelegítés mindegyiknek jó. Aki nem mozdul foglalás felé, annak
// semmi nem töltődik le.
let trafftWarmed = false
function warmTrafft(url: string) {
    if (trafftWarmed) return
    if (typeof document === "undefined" || !url) return
    trafftWarmed = true
    const frame = document.createElement("iframe")
    frame.src = url
    frame.setAttribute("aria-hidden", "true")
    frame.setAttribute("tabindex", "-1")
    frame.style.cssText =
        "position:absolute;left:-9999px;top:-9999px;width:1px;height:1px;opacity:0;border:0;pointer-events:none"
    document.body.appendChild(frame)
    // 25 mp után elengedjük — a letöltött fájlok a böngésző cache-ében maradnak
    window.setTimeout(() => {
        try {
            frame.remove()
        } catch (e) {}
    }, 25000)
}

