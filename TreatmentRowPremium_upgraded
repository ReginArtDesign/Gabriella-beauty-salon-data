interface TreatmentRowPremiumProps {
    name?: string
    description?: string
    thumbnail?: any
    priceSingle?: string
    priceAbo3?: string
    priceAbo6?: string
    duration?: string
    category?: string
    badgeText?: string
    bullet1?: string
    bullet2?: string
    bullet3?: string
    bullet4?: string
    goalsCsv?: string
    searchKeywordsCsv?: string
    enableFilterResponse?: boolean
    bookingUrl?: string
    ctaLabel?: string
    modalBgColor?: string
    expandImageOnOpen?: boolean
    enableLightbox?: boolean
    style?: React.CSSProperties
}

export default function TreatmentRowPremium({
    name = "Diamant-Mikrodermabrasion",
    description = "Erleben Sie massgeschneiderte Hautpflege mit sofort sichtbarem Ergebnis.",
    thumbnail,
    priceSingle = "165 CHF",
    priceAbo3 = "419 CHF",
    priceAbo6 = "655 CHF",
    duration = "75 Min",
    category = "",
    badgeText = "",
    bullet1 = "",
    bullet2 = "",
    bullet3 = "",
    bullet4 = "",
    goalsCsv = "",
    searchKeywordsCsv = "",
    enableFilterResponse = true,
    bookingUrl = "https://gabriellasbeautysalon.trafft.com/booking",
    ctaLabel = "Jetzt Termin buchen",
    modalBgColor = "#FFFFFF",
    expandImageOnOpen = true,
    enableLightbox = true,
    style,
}: TreatmentRowPremiumProps) {
    const isMobile = useMediaQuery("(max-width: 600px)")
    const [isOpen, setIsOpen] = useState(false)
    const [isBookingOpen, setIsBookingOpen] = useState(false)
    const [isImageOpen, setIsImageOpen] = useState(false)
    const rowRef = useRef<HTMLDivElement>(null)

    const filterVisible = useFilterVisibility(
        enableFilterResponse ? category : "",
        name,
        description,
        priceSingle,
        goalsCsv,
        searchKeywordsCsv
    )

    const thumbnailSrc = resolveSrc(thumbnail)

    // A bélyegkép kinyílása csak desktopon/tableten értelmes: mobilon a kártya
    // teteje ELEVE egy nagy kép, ott nincs mit kinyitni.
    const imageExpands = expandImageOnOpen && !isMobile && Boolean(thumbnailSrc)

    const bullets = useMemo(
        () =>
            [bullet1, bullet2, bullet3, bullet4].filter((b) =>
                Boolean(b && b.trim() !== "")
            ),
        [bullet1, bullet2, bullet3, bullet4]
    )

    const finalBookingUrl = useMemo(() => {
        if (!bookingUrl || bookingUrl.trim() === "") return ""
        try {
            const separator = bookingUrl.includes("?") ? "&" : "?"
            return `${bookingUrl}${separator}service=${encodeURIComponent(
                name.trim()
            )}`
        } catch {
            return bookingUrl
        }
    }, [bookingUrl, name])

    // Az iframe betöltési állapota — amíg false, a naptár-vázlat látszik
    const [bookingLoaded, setBookingLoaded] = useState(false)

    // Előmelegítés: 200 ms rááltás után indul, hogy a véletlen egérmozgás
    // ne indítson letöltést. Elhagyáskor töröljük az időzítőt.
    const warmTimer = useRef<number | null>(null)
    const startWarm = () => {
        if (warmTimer.current !== null) return
        warmTimer.current = window.setTimeout(() => {
            warmTrafft(finalBookingUrl)
        }, 200)
    }
    const cancelWarm = () => {
        if (warmTimer.current !== null) {
            window.clearTimeout(warmTimer.current)
            warmTimer.current = null
        }
    }
    useEffect(() => () => cancelWarm(), [])

    // Minden nyitáskor újra a vázlattal indulunk. Biztonsági időzítő: ha az
    // iframe onLoad eseménye valamiért elmaradna (hálózati hiba), 15 mp után
    // akkor is elrejtjük a vázlatot, hogy ne ragadjon be.
    useEffect(() => {
        if (!isBookingOpen) return
        setBookingLoaded(false)
        const failSafe = window.setTimeout(() => setBookingLoaded(true), 15000)
        return () => window.clearTimeout(failSafe)
    }, [isBookingOpen])

    // A teljes kép nézet megnyitása. A stopPropagation azért kell, mert a
    // desktop soron a kattintás egyébként össze-/kinyitná a részleteket.
    const openImage = (e: React.MouseEvent) => {
        e.preventDefault()
        e.stopPropagation()
        setIsImageOpen(true)
    }

    // Billentyűzetes megnyitás: a kép-doboz role="button", tehát Enter és
    // Space is működjön rajta.
    const openImageOnKey = (e: React.KeyboardEvent) => {
        if (e.key !== "Enter" && e.key !== " ") return
        e.preventDefault()
        e.stopPropagation()
        setIsImageOpen(true)
    }

    const handleInstantBook = (e: React.MouseEvent) => {
        e.preventDefault()
        e.stopPropagation()
        setIsBookingOpen(true)
    }

    // Esc-re zárjon, és amíg nyitva van, ne görögjön a háttér.
    useEffect(() => {
        if (!isImageOpen) return
        const onKey = (e: KeyboardEvent) => {
            if (e.key === "Escape") setIsImageOpen(false)
        }
        const prev = document.body.style.overflow
        document.body.style.overflow = "hidden"
        window.addEventListener("keydown", onKey)
        return () => {
            document.body.style.overflow = prev
            window.removeEventListener("keydown", onKey)
        }
    }, [isImageOpen])

    const toggleOpen = (e: React.MouseEvent) => {
        e.preventDefault()
        e.stopPropagation()
        setIsOpen((v) => !v)
    }

    if (!filterVisible) {
        return (
            <div
                data-ipl-cat={category || undefined}
                style={{ display: "none" }}
            />
        )
    }

    return (
        <div
            data-ipl-cat={category || undefined}
            style={{
