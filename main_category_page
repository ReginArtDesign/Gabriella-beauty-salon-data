// ─── EGYEDI KÁRTYA KOMPONENS (ZÉRÓ KILÓGÁS & BIZTONSÁGOS GOMB ELRENDEZÉS) ─────
function CategoryCard({
    item,
    index,
    gridClass,
    accentColor,
    handleRedirect,
}: {
    item: CategoryItem
    index: number
    gridClass: string
    accentColor: string
    handleRedirect: (url: string) => void
}) {
    const [isExpanded, setIsExpanded] = React.useState(false)
    const [isMobile, setIsMobile] = React.useState(false)
    const isFeature = !!item.isHighlighted

    // SSR-biztos mobilérzékelés
    React.useEffect(() => {
        if (typeof window === "undefined") return
        const mediaQuery = window.matchMedia("(max-width: 768px)")
        const handleMediaChange = (e: any) => {
            setIsMobile(e.matches)
            if (!e.matches) setIsExpanded(false)
        }
        setIsMobile(mediaQuery.matches || "ontouchstart" in window)
        mediaQuery.addEventListener("change", handleMediaChange)
        return () => mediaQuery.removeEventListener("change", handleMediaChange)
    }, [])

    // Ujjmozdulat (Swipe / Pan) érzékelése mobilon
    const handlePanEnd = (event: any, info: any) => {
        if (!isMobile) return
        if (info.offset.y < -15 || info.velocity.y < -80) {
            setIsExpanded(true)
        } else if (info.offset.y > 15 || info.velocity.y > 80) {
            setIsExpanded(false)
        }
    }

    // Kettős nyitási logika mobilon
    const handleMobileToggle = (e: React.MouseEvent) => {
        if (!isMobile) return
        e.stopPropagation()
        setIsExpanded((prev) => !prev)
    }

    return (
        <motion.div
            className={`cp-card ${gridClass}`}
            initial={{ opacity: 0, y: 35 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true, margin: "-50px" }}
            transition={{
                duration: 0.7,
                delay: index * 0.1,
                ease: SMOOTH_EASE,
            }}
            onMouseEnter={() => !isMobile && setIsExpanded(true)}
            onMouseLeave={() => !isMobile && setIsExpanded(false)}
            onPanEnd={handlePanEnd}
            onClick={() => {
                if (isMobile && !isExpanded) setIsExpanded(true)
            }}
        >
            {/* 1. RÉTEG: KÁRTYA HÁTTÉRKÉP */}
            <div className="cp-card-media-wrap">
                <img
                    src={item.imageUrl || PLACEHOLDER}
                    alt={item.titleNormal}
                    className="cp-img"
                    loading="lazy"
                />
            </div>

            {/* 2. RÉTEG: ÁLLANDÓ SÖTÉT ÁTTETSZŐ LUXUSRÉTEG (MINDIG LÁTSZIK!) */}
            <div className="cp-permanent-dark-overlay" />

            {/* VIP BADGE (DESIGN SYSTEM: 99PX PILL SHAPE) */}
            {item.badgeText && item.badgeText.trim() !== "" && (
                <div className="cp-vip-badge-row">
                    <span className="cp-vip-badge-text">{item.badgeText}</span>
                </div>
            )}

            {/* 3. RÉTEG: ALSÓ HORGONYZÁSÚ TARTALOMI BLOKK (BIZTONSÁGOS MARGÓKKAL) */}
            <div className="cp-content-anchor">
                <div className="cp-drawer-inner">
                    {/* FEJLÉC - MINDIG LÁTHATÓ (MINDEN KIJELZŐN) */}
                    <div
                        className="cp-drawer-header"
                        onClick={handleMobileToggle}
                    >
                        <div className="cp-header-text">
                            <div className="cp-card-eyebrow">
                                {item.eyebrow}
                            </div>
                            <h3 className="cp-card-title">
                                {item.titleNormal}{" "}
                                <span className="accent-text">
                                    {item.titleAccent}
                                </span>
                            </h3>
                        </div>

                        {/* MOBIL IRÁNYÍTOTT FORGÓ NYÍL (FELSŐ IGAZÍTÁSSAL) */}
                        <motion.div
                            className="cp-mobile-arrow-toggle"
                            animate={{ rotate: isExpanded ? 180 : 0 }}
                            transition={{ duration: 0.35, ease: SMOOTH_EASE }}
                        >
                            <svg
                                width="18"
                                height="18"
                                viewBox="0 0 18 18"
                                fill="none"
                            >
                                <path
                                    d="M4.5 11.25L9 6.75L13.5 11.25"
                                    stroke="currentColor"
                                    strokeWidth="1.8"
                                    strokeLinecap="round"
                                    strokeLinejoin="round"
                                />
                            </svg>
                        </motion.div>
                    </div>

                    {/* KÜLÖNÁLLÓ ANIMÁLT DIV A LEÍRÁSNAK (ZÉRÓ KILÓGÁS GARANCIA!) */}
                    <motion.div
                        className="cp-drawer-body-wrapper"
                        initial={false}
                        animate={{
                            height: isExpanded ? "auto" : 0,
                            opacity: isExpanded ? 1 : 0,
                            marginTop: isExpanded ? 16 : 0,
                        }}
                        transition={{
                            type: "spring",
                            stiffness: 300,
                            damping: 30,
                            mass: 0.8,
                        }}
                        style={{ overflow: "hidden", width: "100%" }}
                    >
                        <div className="cp-drawer-body">
                            <p className="cp-card-desc">{item.description}</p>

                            {/* INTERAKTÍV ACTION FOOTER (BIZTONSÁGOS FLEXBOX GOMB ELRENDEZÉS) */}
                            <div className="cp-card-footer">
                                <span
                                    className="cp-explore-text"
                                    onClick={(e) => {
                                        e.stopPropagation()
                                        handleRedirect(item.pageUrl)
                                    }}
                                >
                                    Behandlung entdecken
                                </span>
                                <div
                                    className="cp-action-btn"
                                    onClick={(e) => {
                                        e.stopPropagation()
                                        handleRedirect(item.pageUrl)
                                    }}
                                >
                                    <svg
                                        width="14"
                                        height="14"
                                        viewBox="0 0 14 14"
                                        fill="none"
                                    >
