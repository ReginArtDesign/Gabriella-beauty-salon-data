                        viewport={{ once: true, margin: "-50px" }}
                        transition={{ duration: 0.7, ease: SMOOTH_EASE }}
                    >
                        <span className="cp-eyebrow">{sectionEyebrow}</span>
                        <h2 className="cp-title">
                            {sectionTitleNormal}{" "}
                            <span className="accent">{sectionTitleAccent}</span>
                        </h2>
                        <p className="cp-subtitle">{sectionSubtitle}</p>
                    </motion.div>

                    {/* SZIMMETRIKUS 2-1-2 BENTO MOSAIC KÁRTYÁK BIZTONSÁGOS GOMBOZÁSSAL */}
                    <div className="cp-grid">
                        {categories.map((cat, index) => (
                            <CategoryCard
                                key={index}
                                item={cat}
                                index={index}
                                gridClass={getGridClass(cat)}
                                accentColor={accentColor}
                                handleRedirect={handleRedirect}
                            />
                        ))}
                    </div>

                    {/* GLOBÁLIS CTA GOMB */}
                    <motion.div
                        className="cp-global-cta-wrap"
                        initial={{ opacity: 0, y: 20 }}
                        whileInView={{ opacity: 1, y: 0 }}
                        viewport={{ once: true }}
                        transition={{
                            duration: 0.6,
                            delay: 0.35,
                            ease: SMOOTH_EASE,
                        }}
                    >
                        <motion.a
                            href={ctaLink}
                            className="cp-mobile-cta"
                            whileHover={{
                                y: -2,
                                boxShadow:
                                    "0 8px 24px rgba(166, 128, 124, 0.25)",
                                filter: "brightness(1.04)",
                            }}
                            whileTap={{ scale: 0.98 }}
                            transition={{ duration: 0.3, ease: SMOOTH_EASE }}
                            style={{
                                display: "inline-flex",
                                alignItems: "center",
                                gap: 10,
                                padding: "16px 36px",
                                background: accentColor,
                                color: "#FFFFFF",
                                fontFamily: "'Montserrat', sans-serif",
                                fontSize: "11px",
                                fontWeight: 600,
                                letterSpacing: "0.16em",
                                textTransform: "uppercase",
                                textDecoration: "none",
                                borderRadius: "4px",
                                boxShadow: "0 4px 16px rgba(0, 0, 0, 0.12)",
                                cursor: "pointer",
                            }}
                        >
                            <span>{ctaText}</span>
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 14 14"
                                fill="none"
                                style={{ flexShrink: 0 }}
                            >
                                <path
                                    d="M2 7h10M8.5 3.5L12 7l-3.5 3.5"
                                    stroke="currentColor"
                                    strokeWidth="1.4"
                                    strokeLinecap="round"
                                    strokeLinejoin="round"
                                />
                            </svg>
                        </motion.a>
                    </motion.div>
                </section>
            </div>
        </>
    )
}

