// ─── EGYEDI KÁRTYA KOMPONENS (ÁLLANDÓ SÖTÉT LAYER & SWIPE-UP DRAWER) ─────────
function CategoryCard({
    item,
    index,
    gridClass,
    accentColor,
    handleRedirect,
}: {
    item: CategoryItem
    index: number
    gridClass: string
    accentColor: string
    handleRedirect: (url: string) => void
}) {
    const [isExpanded, setIsExpanded] = React.useState(false)
    const [isMobile, setIsMobile] = React.useState(false)
    const isFeature = !!item.isHighlighted

    // SSR-biztos felbontás- és érintőkijelző-érzékelés
    React.useEffect(() => {
        if (typeof window === "undefined") return

        const mediaQuery = window.matchMedia("(max-width: 768px)")
        const handleMediaChange = (e: any) => {
            setIsMobile(e.matches)
            if (!e.matches) setIsExpanded(false)
        }

        setIsMobile(mediaQuery.matches || "ontouchstart" in window)
        mediaQuery.addEventListener("change", handleMediaChange)
        return () => mediaQuery.removeEventListener("change", handleMediaChange)
    }, [])

    // Ujjmozdulat (Drag / Swipe-up) érzékelése mobilon[cite: 2, 3]
    const handleDragEnd = (event: any, info: any) => {
        if (!isMobile) return
        if (info.offset.y < -12 || info.velocity.y < -50) {
            setIsExpanded(true)
        } else if (info.offset.y > 12 || info.velocity.y > 50) {
            setIsExpanded(false)
        }
    }

    // Kettős nyitási logika: Swipe-up vagy Tap
    const handleMobileToggle = (e: React.MouseEvent) => {
        if (!isMobile) return
        e.stopPropagation()
        setIsExpanded((prev) => !prev)
    }

    return (
        <motion.div
            className={`cp-card ${gridClass}`}
            initial={{ opacity: 0, y: 35 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true, margin: "-50px" }}
            transition={{
                duration: 0.7,
                delay: index * 0.1,
                ease: SMOOTH_EASE,
            }}
            onMouseEnter={() => !isMobile && setIsExpanded(true)}
            onMouseLeave={() => !isMobile && setIsExpanded(false)}
            onClick={() => {
                if (isMobile && !isExpanded) setIsExpanded(true)
            }}
        >
            {/* 1. RÉTEG: KÁRTYA HÁTTÉRKÉP */}
            <div className="cp-card-media-wrap">
                <img
                    src={item.imageUrl || PLACEHOLDER}
                    alt={item.titleNormal}
                    className="cp-img"
                    loading="lazy"
                />
            </div>

            {/* 2. RÉTEG: ÁLLANDÓ SÖTÉT ÁTTETSZŐ GRADIENT LAYER (MINDIG LÁTSZIK!) */}
            <div className="cp-permanent-dark-overlay" />

            {/* VIP BADGE (99PX PILL SHAPE)[cite: 3] */}
            {isFeature && (
                <motion.div
                    className="cp-vip-badge-row"
                    initial={{ scale: 0.8, opacity: 0 }}
                    whileInView={{ scale: 1, opacity: 1 }}
                    viewport={{ once: true }}
                    transition={{
                        type: "spring",
                        stiffness: 200,
                        damping: 16,
                        delay: 0.25,
                    }}
                >
                    <span className="cp-vip-badge-text">
                        {item.badgeText || "Luzern Exklusiv"}
                    </span>
                </motion.div>
            )}

            {/* 3. RÉTEG: INTERAKTÍV FELHÚZHATÓ TARTALOMI BLOKK (SWIPE-UP DRAWER)[cite: 2] */}
            <motion.div
                className="cp-content-drawer"
                drag={isMobile ? "y" : false}
                dragConstraints={{ top: 0, bottom: 0 }}
                dragElastic={0.12}
                onDragEnd={handleDragEnd}
                animate={{
                    y: isExpanded
                        ? 0
                        : isMobile
                          ? "calc(100% - 88px)"
                          : "calc(100% - 94px)",
                }}
                transition={{
                    type: "spring",
                    stiffness: 280,
                    damping: 28,
                    mass: 0.8,
                }}
            >
                {/* MOBIL VÍZSZINTES DRAGGABLE FOGANTYÚ[cite: 2] */}
                <div
                    className="cp-drag-handle-bar"
                    onClick={handleMobileToggle}
                >
                    <div className="cp-drag-indicator" />
                </div>

                <div className="cp-drawer-inner">
                    {/* FEJLÉC - SZIGORÚ VILÁGOS BÉZS (#F7ECDF) & FEHÉR (#FFFFFF)[cite: 1, 3] */}
                    <div
                        className="cp-drawer-header"
                        onClick={handleMobileToggle}
                    >
                        <div className="cp-card-eyebrow">{item.eyebrow}</div>
                        <h3 className="cp-card-title">
                            {item.titleNormal}{" "}
                            <span className="accent-text">
                                {item.titleAccent}
                            </span>
                        </h3>
                    </div>

                    {/* KIBONTÓDÓ LEÍRÁS ÉS AKCIÓ GOMB */}
                    <div className="cp-drawer-body">
                        <p className="cp-card-desc">{item.description}</p>

                        <div className="cp-card-footer">
                            <span
                                className="cp-explore-text"
                                onClick={(e) => {
                                    e.stopPropagation()
                                    handleRedirect(item.pageUrl)
                                }}
                            >
                                Behandlung entdecken
                            </span>
                            <div
                                className="cp-action-btn"
                                onClick={(e) => {
                                    e.stopPropagation()
                                    handleRedirect(item.pageUrl)
                                }}
                            >
                                <svg
                                    width="14"
                                    height="14"
                                    viewBox="0 0 14 14"
                                    fill="none"
                                >
                                    <path
                                        d="M5 9L9 5M9 5H5.5M9 5V8.5"
                                        stroke="currentColor"
                                        strokeWidth="1.6"
                                        strokeLinecap="round"
                                        strokeLinejoin="round"
                                    />
                                </svg>
                            </div>
                        </div>
                    </div>
                </div>
            </motion.div>
        </motion.div>
    )
}

