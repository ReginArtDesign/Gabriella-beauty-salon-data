                        <p className="cp-subtitle">{sectionSubtitle}</p>
                    </motion.div>

                    {/* ASZIMMETRIKUS BENTO MOSAIC KÁRTYÁK SWIPE-UP DRAWERREL[cite: 2, 3] */}
                    <div className="cp-grid">
                        {categories.map((cat, index) => (
                            <CategoryCard
                                key={index}
                                item={cat}
                                index={index}
                                gridClass={getGridClass(cat)}
                                accentColor={accentColor}
                                handleRedirect={handleRedirect}
                            />
                        ))}
                    </div>

                    {/* GLOBÁLIS CTA GOMB */}
                    <motion.div
                        className="cp-global-cta-wrap"
                        initial={{ opacity: 0, y: 20 }}
                        whileInView={{ opacity: 1, y: 0 }}
                        viewport={{ once: true }}
                        transition={{
                            duration: 0.6,
                            delay: 0.35,
                            ease: SMOOTH_EASE,
                        }}
                    >
                        <motion.a
                            href={ctaLink}
                            className="cp-mobile-cta"
                            whileHover={{
                                y: -2,
                                boxShadow:
                                    "0 8px 24px rgba(166, 128, 124, 0.25)", //[cite: 3]
                                filter: "brightness(1.04)",
                            }}
                            whileTap={{ scale: 0.98 }}
                            transition={{ duration: 0.3, ease: SMOOTH_EASE }}
                            style={{
                                display: "inline-flex",
                                alignItems: "center",
                                gap: 10,
                                padding: "16px 36px",
                                background: accentColor,
                                color: "#FFFFFF",
                                fontFamily: "'Montserrat', sans-serif", //[cite: 1, 3]
                                fontSize: "11px",
                                fontWeight: 600,
                                letterSpacing: "0.16em",
                                textTransform: "uppercase",
                                textDecoration: "none",
                                borderRadius: "4px", // Brand Guidelines: 4px[cite: 3]
                                boxShadow: "0 4px 16px rgba(0, 0, 0, 0.12)", // Hivatalos árnyék[cite: 3]
                                cursor: "pointer",
                            }}
                        >
                            <span>{ctaText}</span>
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 14 14"
                                fill="none"
                                style={{ flexShrink: 0 }}
                            >
                                <path
                                    d="M2 7h10M8.5 3.5L12 7l-3.5 3.5"
                                    stroke="currentColor"
                                    strokeWidth="1.4"
                                    strokeLinecap="round"
                                    strokeLinejoin="round"
                                />
                            </svg>
                        </motion.a>
                    </motion.div>
                </section>
            </div>
        </>
    )
}

