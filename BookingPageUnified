                            <motion.div
                                initial={{ opacity: 0, y: 10 }}
                                animate={{ opacity: 1, y: 0 }}
                                transition={{
                                    duration: 0.4,
                                    ease: SMOOTH_EASE,
                                }}
                                style={{
                                    textAlign: "center",
                                    padding: "64px 24px",
                                    background: "#FFFFFF",
                                    borderRadius: "16px",
                                    border: `1px dashed ${borderColor}`,
                                    margin: "20px 0 60px 0",
                                }}
                            >
                                <h3
                                    style={{
                                        fontFamily: "'Montserrat', sans-serif",
                                        fontSize: "18px",
                                        color: textColor,
                                        margin: "0 0 8px 0",
                                        fontWeight: 500,
                                    }}
                                >
                                    Keine Behandlungen gefunden
                                </h3>
                                <p
                                    style={{
                                        fontSize: "14px",
                                        color: mutedColor,
                                        margin: "0 auto 24px auto",
                                        maxWidth: "420px",
                                        lineHeight: 1.6,
                                    }}
                                >
                                    Wir konnten keine Behandlungen mit Ihren
                                    aktuellen Filterkriterien finden. Bitte
                                    lockern Sie Ihre Suche oder setzen Sie die
                                    Filter zurück.
                                </p>
                                <motion.button
                                    type="button"
                                    onClick={() => {
                                        setSearchQuery("")
                                        setActiveCategory("alle")
                                        setActiveZone("alle")
                                    }}
                                    whileHover={{
                                        y: -2,
                                        boxShadow:
                                            "0 8px 20px rgba(163, 124, 120, 0.2)",
                                    }}
                                    whileTap={{ scale: 0.98 }}
                                    style={{
                                        padding: "12px 28px",
                                        background: accentColor,
                                        color: "#FFFFFF",
                                        border: "none",
                                        borderRadius: "4px",
                                        fontFamily: "'Montserrat', sans-serif",
                                        fontSize: "11px",
                                        fontWeight: 600,
                                        letterSpacing: "0.14em",
                                        textTransform: "uppercase",
                                        cursor: "pointer",
                                        boxShadow:
                                            "0 4px 16px rgba(163, 124, 120, 0.12)",
                                    }}
                                >
                                    Alle Filter zurücksetzen
                                </motion.button>
                            </motion.div>
                        )}

                        {/* ÉS ITT A JOGI / ÁR MEGJEGYZÉS (DISCLAIMER) EGYBŐL A LISTA ALATT */}
                        {disclaimerText && visibleCategories.length > 0 && (
                            <div className="cp-disclaimer">
                                {disclaimerText}
                            </div>
                        )}

                        <div className="cp-bottom-divider">
                            <div className="cp-divider-line" />
                            <div className="cp-divider-diamond" />
                            <div className="cp-divider-line" />
                        </div>
                    </div>
                </section>

                <BookingModal
                    treatment={selectedTreatment}
                    onClose={() => setSelectedTreatment(null)}
                    accentColor={accentColor}
                    textColor={textColor}
                    mutedColor={mutedColor}
                />
            </div>
        </>
    )
}

