// ─── FŐ KOMPONENS ────────────────────────────────────────────────────────────
export default function BookingPageUnifiedCMS({
    dataSourceSelector = "[data-treatment-payload]",
    categoriesOrder = "",
    categoryDescriptions = "",
    heroEyebrow = "ONLINE TERMINBUCHUNG",
    heroTitle = "Wählen Sie Ihre Behandlung",
    heroDesc = "Buchen Sie Ihren Wunschtermin unkompliziert online. Wählen Sie untenstehend Ihre Behandlung aus, um freie Termine zu sehen.",
    heroScrollText = "DIREKT ZUR BEHANDLUNGSÜBERSICHT",
    heroBgColor = "#F7ECDF",
    listBgColor = "#FFFFFF",
    accentColor = "#A6807C",
    textColor = "#3a3028",
    mutedColor = "#7a7369",
    borderColor = "#EFEBE6",
    searchPlaceholder = "Behandlung suchen...",
    disclaimerText = "Bitte beachten Sie: Die angegebenen Preise und Behandlungsdauer sind Richtwerte und können je nach individuellem Aufwand im Salon leicht variieren.",
}: BookingPageProps) {
    const [selectedTreatment, setSelectedTreatment] =
        useState<RawTreatmentPayload | null>(null)
    const [searchQuery, setSearchQuery] = useState("")
    const [isSearchFocused, setIsSearchFocused] = useState(false)
    const [activeCategory, setActiveCategory] = useState("alle")
    const [activeZone, setActiveZone] = useState("alle")
    const [sortMode, setSortMode] = useState<SortMode>("az")
    const [isFilterMenuOpen, setIsFilterMenuOpen] = useState(false)
    const filterMenuRef = useRef<HTMLDivElement>(null)

    const [rawItems, setRawItems] = useState<RawTreatmentPayload[]>([])
    const rescanTimer = useRef<number | null>(null)

    const scanDom = useCallback(() => {
        const nodes = Array.from(
            document.querySelectorAll(dataSourceSelector)
        ) as HTMLElement[]
        const parsed: RawTreatmentPayload[] = []
        nodes.forEach((node) => {
            const raw = node.getAttribute("data-treatment-payload")
            if (!raw) return
            try {
                const obj = JSON.parse(raw)
                if (obj && obj.name) parsed.push(obj)
            } catch {
                // hibás payload - kihagyjuk
            }
        })
        setRawItems(parsed)
    }, [dataSourceSelector])

    useEffect(() => {
        scanDom()
        const observer = new MutationObserver(() => {
            if (rescanTimer.current) window.clearTimeout(rescanTimer.current)
            rescanTimer.current = window.setTimeout(scanDom, 200)
        })
        observer.observe(document.body, { childList: true, subtree: true })
        return () => {
            observer.disconnect()
            if (rescanTimer.current) window.clearTimeout(rescanTimer.current)
        }
    }, [scanDom])

    const categoryDescMap = useMemo(() => {
        const map = new Map<string, string>()
        categoryDescriptions
            .split(/\r?\n/)
            .map((l) => l.trim())
            .filter(Boolean)
            .forEach((line) => {
                const idx = line.indexOf(":")
                if (idx > -1)
                    map.set(
                        line.slice(0, idx).trim(),
                        line.slice(idx + 1).trim()
                    )
            })
        return map
    }, [categoryDescriptions])

    const groups = useMemo(() => {
        if (rawItems.length === 0) return []
        const manualOrder = categoriesOrder
            .split(",")
            .map((s) => s.trim())
            .filter(Boolean)
        const order: string[] = [...manualOrder]
        const grouped = new Map<string, RawTreatmentPayload[]>()

        rawItems.forEach((item) => {
            const cats = (item.category || "")
                .split(",")
                .map((s) => s.trim())
                .filter(Boolean)
            if (cats.length === 0) cats.push("Weitere Behandlungen")
            cats.forEach((cat) => {
                if (!grouped.has(cat)) grouped.set(cat, [])
                grouped.get(cat)!.push(item)
                if (!order.includes(cat)) order.push(cat)
            })
        })

        return order
            .filter((cat) => grouped.has(cat))
            .map((cat) => ({
                id: slugify(cat),
                categoryLabel: cat,
                title: cat,
                leadText:
                    categoryDescMap.get(cat) ||
                    `${grouped.get(cat)!.length} Behandlung${grouped.get(cat)!.length === 1 ? "" : "en"}`,
                items: grouped.get(cat)!,
            }))
    }, [rawItems, categoriesOrder, categoryDescMap])

    const categoryOptions = useMemo(
        () => [
            { id: "alle", label: "Alle Behandlungen" },
            ...groups.map((g) => ({ id: g.id, label: g.categoryLabel })),
        ],
        [groups]
    )

    const zoneOptions = useMemo(() => {
        const zones = new Set<string>()
        rawItems.forEach((item) => {
            if (item.zone && item.zone.trim() !== "")
                zones.add(item.zone.trim())
        })
        if (zones.size === 0) return []
        return [
            { id: "alle", label: "Alle Zonen" },
            ...Array.from(zones).map((z) => ({ id: z, label: z })),
        ]
    }, [rawItems])

    const hasZoneFilter = zoneOptions.length > 0

    useEffect(() => {
        const handleClickOutside = (event: MouseEvent) => {
            if (
                filterMenuRef.current &&
                !filterMenuRef.current.contains(event.target as Node)
            ) {
                setIsFilterMenuOpen(false)
            }
        }
        document.addEventListener("mousedown", handleClickOutside)
        return () =>
            document.removeEventListener("mousedown", handleClickOutside)
    }, [])

    const handleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
        if (e.key === "Enter") {
            e.currentTarget.blur()
            setIsFilterMenuOpen(false)
